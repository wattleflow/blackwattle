# Copy to `.env` (git-ignored) and set real values. Nothing here is a secret.
# GRAFANA_SECRET_KEY signs cookies and encrypts stored datasource secrets:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_SECRET_KEY=change-me
