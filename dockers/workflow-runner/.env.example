# Environment for workflow runner and monitoring stack
# Copy to `.env` (git-ignored) and set real values.
#
# Credentials: nothing here is a secret per se, but treat GRAFANA_SECRET_KEY
# as a cryptographic seed (signs cookies, encrypts stored datasource secrets).
# Generate a new one: python3 -c "import secrets; print(secrets.token_hex(32))"

# Grafana credentials (monitoring stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_SECRET_KEY=change-me

# Workflow configuration (optional, see docker-compose.yaml for defaults)
# LOG_LEVEL=INFO
# PYTHONUNBUFFERED=1
